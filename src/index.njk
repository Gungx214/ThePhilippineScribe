---js
{
  layout: "layouts/base.njk",
  title: "The Philippine Scribe",
  pagination: {
    data: "collections.articles",
    size: 3,
    alias: "olderArticles",
    before: function(articles) {
      return articles.slice(4);
    }
  }
}
---
{% set articles = collections.articles | default([]) %}
{% if articles.length > 0 %}
  {% set hero = articles[0] %}
  <div class="section-label">Top story</div>
  <div class="hero">
    <a class="hero-main" href="{{ hero.url | url }}">
      <span class="top-badge">Top Story</span>
      {% if hero.data.image %}
        <img src="{{ hero.data.image | url }}" alt="{{ hero.data.title }}" class="hero-img">
      {% else %}
        <div class="hero-img"></div>
      {% endif %}
      <div class="dateline">{{ hero.data.location }} — {{ hero.data.date | displayDate }}</div>
      <h1>{{ hero.data.title }}</h1>
      <p class="dek">{{ hero.data.dek }}</p>
    </a>
    <div class="hero-side">
      <div class="hero-side-label">Latest</div>
      {% for item in articles.slice(1, 4) %}
      <a class="side-item" href="{{ item.url | url }}">
        {% if item.data.image %}
          <img src="{{ item.data.image | url }}" alt="{{ item.data.title }}" class="side-img">
        {% else %}
          <div class="side-img"></div>
        {% endif %}
        <div class="dateline">{{ item.data.location }} — {{ item.data.date | displayDate }}</div>
        <h3>{{ item.data.title }}</h3>
      </a>
      {% endfor %}
    </div>
  </div>
{% else %}
  <div style="padding: 40px 0; text-align: center;">
    <h2>No articles found</h2>
  </div>
{% endif %}

<div id="older-news-section">
{% if olderArticles.length > 0 %}
<div class="section-label">Older News</div>
<div class="grid">
  {% for item in olderArticles %}
  <a class="card" href="{{ item.url | url }}">
    {% if item.data.image %}
      <img src="{{ item.data.image | url }}" alt="{{ item.data.title }}" class="card-img">
    {% else %}
      <div class="card-img"></div>
    {% endif %}
    <div class="dateline">{{ item.data.location }} — {{ item.data.date | displayDate }}</div>
    <h3>{{ item.data.title }}</h3>
    <p>{{ item.data.dek }}</p>
  </a>
  {% endfor %}
</div>

<div class="pagination-nav">
  {% for href in pagination.hrefs %}
    <a class="page-link{% if loop.index0 == pagination.pageNumber %} active{% endif %}" href="{{ href }}">{{ loop.index }}</a>
  {% endfor %}
</div>
{% endif %}
</div>

<script>
(function(){
  var container = document.getElementById('older-news-section');
  if(!container) return;

  function loadPage(url, pushState){
    fetch(url)
      .then(function(res){ return res.text(); })
      .then(function(html){
        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');
        var newSection = doc.getElementById('older-news-section');
        if(newSection){
          container.innerHTML = newSection.innerHTML;
        }
        if(pushState){
          history.pushState({}, '', url);
        }
      })
      .catch(function(){
        window.location.href = url;
      });
  }

  container.addEventListener('click', function(e){
    var link = e.target.closest('.page-link');
    if(!link) return;
    e.preventDefault();
    loadPage(link.getAttribute('href'), true);
  });

  window.addEventListener('popstate', function(){
    loadPage(window.location.href, false);
  });
})();
</script>
