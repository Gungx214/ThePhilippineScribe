---js
{
  layout: "layouts/base.njk",
  title: "The Philippine Scribe",
  pagination: {
    data: "collections.articles",
    size: 3,
    alias: "olderArticles",
    before: function(articles) {
      return articles.slice(4);
    }
  }
}
---
{% set articles = collections.articles | default([]) %}
{% if articles.length > 0 %}
  {% set hero = articles[0] %}
  <div class="section-label">Top story</div>
  <div class="hero">
    <a class="hero-main" href="{{ hero.url | url }}">
      <span class="top-badge">Top Story</span>
      {% if hero.data.image %}
        <img src="{{ hero.data.image | url }}" alt="{{ hero.data.title }}" class="hero-img">
      {% else %}
        <div class="hero-img"></div>
      {% endif %}
      <div class="dateline">{{ hero.data.location }} — {{ hero.data.date | displayDate }}</div>
      <h1>{{ hero.data.title }}</h1>
      <p class="dek">{{ hero.data.dek }}</p>
    </a>
    <div class="hero-side">
      <div class="hero-side-label">Latest</div>
      {% for item in articles.slice(1, 4) %}
      <a class="side-item" href="{{ item.url | url }}">
        {% if item.data.image %}
          <img src="{{ item.data.image | url }}" alt="{{ item.data.title }}" class="side-img">
        {% else %}
          <div class="side-img"></div>
        {% endif %}
        <div class="dateline">{{ item.data.location }} — {{ item.data.date | displayDate }}</div>
        <h3>{{ item.data.title }}</h3>
      </a>
      {% endfor %}
    </div>
  </div>
{% else %}
  <div style="padding: 40px 0; text-align: center;">
    <h2>No articles found</h2>
  </div>
{% endif %}

{% if olderArticles.length > 0 %}
<div class="section-label">Older News</div>
<div class="grid">
  {% for item in olderArticles %}
  <a class="card" href="{{ item.url | url }}">
    {% if item.data.image %}
      <img src="{{ item.data.image | url }}" alt="{{ item.data.title }}" class="card-img">
    {% else %}
      <div class="card-img"></div>
    {% endif %}
    <h3>{{ item.data.title }}</h3>
    <p>{{ item.data.dek }}</p>
  </a>
  {% endfor %}
</div>

<div class="pagination-nav">
  {% if pagination.href.previous %}
    <a class="page-link" href="{{ pagination.href.previous }}">&larr; Newer</a>
  {% endif %}
  {% if pagination.href.next %}
    <a class="page-link" href="{{ pagination.href.next }}">Older &rarr;</a>
  {% endif %}
</div>
{% endif %}
